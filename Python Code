def normal_pdf(x): return np.exp(-0.5*x**2)/np.sqrt(2*np.pi)
def normal_cdf(x): return ndtr(x)

def probit_loglik(beta, X, y):
    xb = np.clip(X @ beta, -10, 10)
    p  = np.clip(normal_cdf(xb), 1e-10, 1-1e-10)
    return -np.sum(y*np.log(p) + (1-y)*np.log(1-p))

def probit_gradient(beta, X, y):
    xb  = np.clip(X @ beta, -10, 10)
    p   = np.clip(normal_cdf(xb), 1e-10, 1-1e-10)
    phi = normal_pdf(xb)
    return -(X.T @ ((y-p)*phi/(p*(1-p))))

def ols_with_se(X, y):
    b,_,_,_ = np.linalg.lstsq(X, y, rcond=None)
    e   = y - X@b
    s2  = np.sum(e**2)/(len(y)-X.shape[1])
    cov = s2*np.linalg.pinv(X.T@X)
    return b, np.sqrt(np.diag(cov)), e

def print_regression_table(varnames, coefs, ses, title):
    print(f"\n{'='*70}\n{title}\n{'='*70}")
    print(f"{'Variable':<22} {'Coef':>9} {'SE':>9} {'z':>8} {'p':>8}  Sig")
    print("-"*70)
    zs = coefs/ses; ps = 2*(1-stats.norm.cdf(np.abs(zs)))
    for name,c,s,z,p in zip(varnames,coefs,ses,zs,ps):
        stars = ('***' if p<0.001 else '**' if p<0.01 else '*' if p<0.05 else '.' if p<0.1 else '')
        print(f"{name:<22} {c:>9.4f} {s:>9.4f} {z:>8.3f} {p:>8.4f}  {stars}")
    print("-"*70)

