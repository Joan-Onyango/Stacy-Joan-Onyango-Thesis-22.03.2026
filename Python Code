def simcop(city,n,seed):
    rng=np.random.default_rng(seed); p=cp[city]
    L=np.linalg.cholesky(p['corr']); z=rng.standard_normal((n,5))
    return ((z@L.T)>stats.norm.ppf(1-p['mu'])).astype(float)

