        continue
    actual_sub      = np.mean(y_ext[mask_sub])
    counter_sub     = np.mean(X_ext[mask_sub] @ b0[:-1] + b0[-1] * l0_ext[mask_sub])
    ATT_sub         = actual_sub - counter_sub
    print(f"\n  {label}  (N owners = {mask_sub.sum()})")
    print(f"    Actual FRIndex:            {actual_sub:.4f}")
    print(f"    Counterfactual (if renter): {counter_sub:.4f}")
    print(f"    ATT:                       {ATT_sub:+.4f}")


# =============================================================================
# SECTION 8: HETEROGENEITY BY REGULATORY COMPLEXITY (H2 test)
# The ESR is re-estimated separately for LOW and HIGH regulatory complexity
# subsamples to test whether the ATT differs across institutional environments.
# H2: Higher regulatory complexity reduces the ownership benefit (thesis Section 1.6).
# =============================================================================

print("\n" + "="*65)
print("STEP 7: HETEROGENEITY BY REGULATORY COMPLEXITY (H2 TEST)")
print("="*65)
print(f"  Classification: RCIndex > {rc_county_median:.3f} (47-county median) → HIGH")
print(f"  LOW RC: Nakuru (0.441), Mombasa (0.642)")
print(f"  HIGH RC: Kisumu (0.747), Nairobi City (0.968)")

rc_atts = {}
for rc_grp, label in [(0, 'LOW Regulatory Complexity'),
                       (1, 'HIGH Regulatory Complexity')]:
    sub   = df[df['RC_high'] == rc_grp].reset_index(drop=True)
    n_sub = len(sub)
    if n_sub < 50:
        print(f"\n  [{label}]: N = {n_sub} — insufficient observations, skipped")
        rc_atts[rc_grp] = np.nan
        continue

    Zs   = np.column_stack([np.ones(n_sub)] + [sub[v].values for v in Z_vars])
    Xs   = np.column_stack([np.ones(n_sub)] + [sub[v].values for v in X_vars])
    yos  = sub['owner'].values
    yhs  = sub[outcome_var].values

    res_s  = minimize(probit_loglik, np.zeros(Zs.shape[1]),
                      args=(Zs, yos), method='BFGS',
                      options={'maxiter': 500})
    gs     = res_s.x
    xbs    = np.clip(Zs @ gs, -10, 10)
    l1s    =  normal_pdf(xbs) / np.clip(normal_cdf(xbs), 1e-10, 1)
    l0s    = -normal_pdf(xbs) / np.clip(1 - normal_cdf(xbs), 1e-10, 1)
    m1s    = yos == 1;  m0s = yos == 0

    b1s, se1s, e1s = ols_with_se(np.column_stack([Xs[m1s], l1s[m1s]]), yhs[m1s])
    b0s, se0s, e0s = ols_with_se(np.column_stack([Xs[m0s], l0s[m0s]]), yhs[m0s])

    E_Y1s   = np.mean(yhs[m1s])
    E_Y0s_c = np.mean(Xs[m1s] @ b0s[:-1] + b0s[-1] * l0s[m1s])
    ATT_s   = E_Y1s - E_Y0s_c
    w1s     = b1s[-1] / np.std(e1s)
    w0s     = b0s[-1] / np.std(e0s)
    rc_atts[rc_grp] = ATT_s

    print(f"\n  [{label}]  N = {n_sub}  (owners = {m1s.sum()}, renters = {m0s.sum()})")
    zs1 = b1s / se1s;  ps1 = 2 * (1 - stats.norm.cdf(np.abs(zs1)))
    zs0 = b0s / se0s;  ps0 = 2 * (1 - stats.norm.cdf(np.abs(zs0)))
    print(f"  {'Variable':<18} {'Owner Coef':>12} {'Renter Coef':>13}")
    for i, vn in enumerate(['Intercept'] + X_vars + ['IMR']):
        s1 = '***' if ps1[i]<0.001 else '**' if ps1[i]<0.01 else '*' if ps1[i]<0.05 else ''
        s0 = '***' if ps0[i]<0.001 else '**' if ps0[i]<0.01 else '*' if ps0[i]<0.05 else ''
        print(f"  {vn:<18} {b1s[i]:>10.4f}{s1:<3}  {b0s[i]:>10.4f}{s0}")
    print(f"  ω₁ = {w1s:.4f}   ω₀ = {w0s:.4f}")
    print(f"  ATT = {ATT_s:+.4f}   (Actual = {E_Y1s:.4f}, Counterfactual = {E_Y0s_c:.4f})")

if not np.isnan(rc_atts.get(0, np.nan)) and not np.isnan(rc_atts.get(1, np.nan)):
    diff = rc_atts[1] - rc_atts[0]
    print(f"\n  ATT_HIGH − ATT_LOW = {diff:+.4f}")
    if diff < 0:
        print(f"  H2: The ownership benefit is smaller in HIGH regulatory complexity")
        print(f"  counties, consistent with the thesis finding that regulatory")
        print(f"  complexity dampens the financial resilience dividend of ownership.")
        print(f"  This reflects extreme positive selection in high-barrier environments:")
        print(f"  only highly capable households enter ownership, so the ESR")
        print(f"  attributes more of their advantage to pre-existing traits rather")
        print(f"  than to ownership itself (thesis Section 5.3).")
    else:
        print(f"  H2 (negative moderation) is not supported in this specification.")


