def subgroup(grp):
    sub=df[df['RC_high']==grp].reset_index(drop=True); ns=len(sub)
    Zs=np.column_stack([np.ones(ns)]+[sub[v].values for v in Zv]); Xs=np.column_stack([np.ones(ns)]+[sub[v].values for v in Xv])
    yos=sub['owner'].values; yhs=sub['FRIndex'].values
    gs=minimize(probit_loglik,np.zeros(Zs.shape[1]),args=(Zs,yos),method='BFGS',options={'maxiter':500}).x
    xbs=np.clip(Zs@gs,-10,10); l1s=normal_pdf(xbs)/np.clip(normal_cdf(xbs),1e-10,1); l0s=-normal_pdf(xbs)/np.clip(1-normal_cdf(xbs),1e-10,1)
    m1s=yos==1;m0s=yos==0
    b1s,_,e1s=ols_with_se(np.column_stack([Xs[m1s],l1s[m1s]]),yhs[m1s])
    b0s,_,e0s=ols_with_se(np.column_stack([Xs[m0s],l0s[m0s]]),yhs[m0s])
    EY1s=yhs[m1s].mean(); EY0sc=(Xs[m1s]@b0s[:-1]+b0s[-1]*l0s[m1s]).mean()
    return EY1s-EY0sc, b1s[-1]/np.std(e1s), b0s[-1]/np.std(e0s), m1s.sum(), m0s.sum(), ns
def boot_sub(grp):
    sub=df[df['RC_high']==grp].reset_index(drop=True); ns=len(sub); np.random.seed(GLOBAL_SEED); out=[]
    for _ in range(500):
        idx=np.random.choice(ns,ns,replace=True); dss=sub.iloc[idx].reset_index(drop=True)
        Zb=np.column_stack([np.ones(ns)]+[dss[v].values for v in Zv]); Xb=np.column_stack([np.ones(ns)]+[dss[v].values for v in Xv])
        yob=dss['owner'].values; yhb=dss['FRIndex'].values
        if yob.sum()<10 or (1-yob).sum()<10: continue
        try:
            gb=minimize(probit_loglik,np.zeros(Zb.shape[1]),args=(Zb,yob),method='BFGS',options={'maxiter':200}).x
            xbb=np.clip(Zb@gb,-10,10); l0b=-normal_pdf(xbb)/np.clip(1-normal_cdf(xbb),1e-10,1)
            m1b=yob==1;m0b=yob==0; b0b,_,_=ols_with_se(np.column_stack([Xb[m0b],l0b[m0b]]),yhb[m0b])
            out.append(yhb[m1b].mean()-(Xb[m1b]@b0b[:-1]+b0b[-1]*l0b[m1b]).mean())
        except: pass
    return np.array(out)
