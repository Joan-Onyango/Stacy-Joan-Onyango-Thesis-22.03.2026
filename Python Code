def _generate_dwelling_data():
    """
    Generate a synthetic KHS dwelling dataset calibrated to thesis Table 4.1.

    Variable distributions (mean, SD) and city-level sample sizes are set
    to match the reported descriptive statistics exactly. This allows the
    full ESR pipeline to run for reproducibility purposes when the original
    restricted-access microdata is unavailable.
    """
    np.random.seed(42)
    # City allocations and ownership rates derived from thesis Section 3.2
    cities = {
        'Nairobi City': {'n': 1050, 'own_rate': 0.148},
        'Mombasa':      {'n': 380,  'own_rate': 0.172},
        'Kisumu':       {'n': 330,  'own_rate': 0.175},
        'Nakuru':       {'n': 258,  'own_rate': 0.178},
    }
    records = []
    for city, cfg in cities.items():
        n_own = round(cfg['n'] * cfg['own_rate'])
        n_ren = cfg['n'] - n_own
        for tenure, count, is_owner in [
            ('OWNS', n_own, True), ('PAYS RENT/LEASE', n_ren, False)
        ]:
            if count <= 0:
                continue
            # Continuous variables drawn from distributions in Table 4.1
            if is_owner:
                ln_r = np.random.normal(1.617, 0.499, count).clip(0.1, 3.5)
                ln_a = np.random.normal(5.006, 0.654, count).clip(2.0, 8.0)
                fsz  = np.random.normal(2.892, 0.884, count).clip(1, 10)
                d03_pool = ['BUNGALOW']*60 + ['FLAT / APARTMENT']*25 + ['MAISONETTE']*10 + ['TOWNHOUSE']*5
                d14_pool = ['Concrete/ Cement/Terrazo']*50 + ['Ceramic tiles']*30 + ['Vinyl or asphalt strips']*20
                d15_pool = ['Cement blocks']*40 + ['Bricks']*30 + ['Stone with lime/cement']*20 + ['Iron sheets']*10
                p_elec, p_water = 0.92, 0.85
            else:
                ln_r = np.random.normal(0.988, 0.435, count).clip(0.1, 2.5)
                ln_a = np.random.normal(3.601, 0.530, count).clip(1.5, 6.5)
                fsz  = np.random.normal(1.955, 0.721, count).clip(1, 8)
                d03_pool = ['BUNGALOW']*50 + ['FLAT / APARTMENT']*30 + ['BEDSITTER']*15 + ['SINGLE ROOM']*5
                d14_pool = ['Concrete/ Cement/Terrazo']*40 + ['Vinyl or asphalt strips']*30 + ['Earth/sand']*15 + ['Ceramic tiles']*15
                d15_pool = ['Iron sheets']*35 + ['Cement blocks']*30 + ['Bricks']*20 + ['Stone with mud']*15
                p_elec, p_water = 0.78, 0.68

            rooms = np.round(np.expm1(ln_r)).clip(1, 10).astype(int)
            area  = np.expm1(ln_a).clip(5, 500)
            fsize = np.round(fsz).astype(int)
            d03   = np.random.choice(d03_pool, count)
            d14   = np.random.choice(d14_pool, count)
            d15   = np.random.choice(d15_pool, count)
            d05   = np.random.choice(['Yes', 'No'], count, p=[p_elec,   1 - p_elec])
            d06   = np.random.choice(['Yes', 'No'], count, p=[p_water,  1 - p_water])

            for i in range(count):
                records.append({
                    'a01': city, 'a07_1': 'Urban', 'd03': d03[i],
                    'd05': d05[i], 'd06': d06[i], 'd08': rooms[i],
                    'd11_1': float(area[i]), 'd12': tenure,
                    'd13': float(fsize[i]), 'd14': d14[i], 'd15': d15[i],
                })
    return pd.DataFrame(records)


