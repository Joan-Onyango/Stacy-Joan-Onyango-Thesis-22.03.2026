# SECTION 7: HETEROGENEITY BY HOUSING TYPE (proxy for mortgage status)
# Formal dwellings (flat/maisonette/townhouse) are associated with mortgage
# finance; informal dwellings (bungalow/other) with outright purchase.
# =============================================================================

print("\n" + "="*65)
print("STEP 6: HETEROGENEITY BY HOUSING TYPE (Mortgage Proxy)")
print("="*65)
print("  Formal: flat/apartment, maisonette, townhouse → proxy for mortgage")
print("  Informal: bungalow/other → proxy for outright purchase or informal finance")

analysis['formal'] = analysis['d03'].isin(
    ['FLAT / APARTMENT', 'MAISONETTE', 'TOWNHOUSE']).astype(int)

df_ext = analysis[['owner', outcome_var, 'ln_rooms', 'ln_area',
                    'familysize', 'ln_HP', 'RCIndex', 'RC_high',
                    'county_id', 'formal']].dropna().reset_index(drop=True)
y_ext    = df_ext[outcome_var].values
