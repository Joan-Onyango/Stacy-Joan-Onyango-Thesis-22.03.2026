def normal_pdf(x):
    """Standard normal probability density function."""
    return np.exp(-0.5 * x**2) / np.sqrt(2 * np.pi)


def normal_cdf(x):
    """Standard normal cumulative distribution function."""
    return ndtr(x)


def probit_loglik(beta, X, y):
    """
    Negative log-likelihood for the probit model.
    Used in scipy.optimize.minimize (minimisation of negative log-likelihood
    is equivalent to maximum likelihood estimation).
    """
    xb = np.clip(X @ beta, -10, 10)
    p  = np.clip(normal_cdf(xb), 1e-10, 1 - 1e-10)
    return -np.sum(y * np.log(p) + (1 - y) * np.log(1 - p))


def probit_gradient(beta, X, y):
    """
    Analytic score vector (gradient) of the probit log-likelihood.
    Supplying the analytic gradient improves convergence speed and
    numerical accuracy relative to finite-difference approximation.
    """
    xb    = np.clip(X @ beta, -10, 10)
    p     = np.clip(normal_cdf(xb), 1e-10, 1 - 1e-10)
    phi   = normal_pdf(xb)
    score = (y - p) * phi / (p * (1 - p))
    return -(X.T @ score)


def ols_with_se(X, y):
    """
    OLS estimator with classical (homoskedastic) standard errors.
    Returns coefficient vector, standard errors, and residuals.
    Used for the regime-specific outcome equations in Step 4b.
    """
    b, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    e   = y - X @ b
    s2  = np.sum(e**2) / (len(y) - X.shape[1])
    cov = s2 * np.linalg.pinv(X.T @ X)
    se  = np.sqrt(np.diag(cov))
    return b, se, e


def print_regression_table(varnames, coefs, ses, title):
    """Format and print a regression results table with significance stars."""
    print(f"\n{'='*65}")
    print(title)
    print(f"{'='*65}")
    print(f"{'Variable':<22} {'Coef':>8} {'SE':>8} {'z':>8} {'p':>7}  Sig")
    print("-" * 65)
    zs = coefs / ses
    ps = 2 * (1 - stats.norm.cdf(np.abs(zs)))
    for name, c, s, z, p in zip(varnames, coefs, ses, zs, ps):
        stars = ('***' if p < 0.001 else '**' if p < 0.01
                 else '*' if p < 0.05 else '.' if p < 0.1 else '')
        print(f"{name:<22} {c:>8.4f} {s:>8.4f} {z:>8.3f} {p:>7.4f}  {stars}")
    print("-" * 65)


def harmonise_county_names(name_series):
    """
    Standardise county name strings across all KHS questionnaire modules.

    The KHS institutional questionnaires were administered separately to
    county planning departments, financiers, and developers, leading to
    inconsistent capitalisation and encoding of county names (e.g.,
    'NAIROBI CITY' vs 'Nairobi City', 'Murang\u00e2a' vs "Murang'a").
    This function applies a deterministic lookup before falling back to
    title-case for names not in the lookup table.
    """
    lookup = {
        'NAIROBI CITY'    : 'Nairobi City',
        'NAIROBI'         : 'Nairobi City',
        "MURANG'A"        : "Murang'a",
        'MURANGA'         : "Murang'a",
        'Muranga'         : "Murang'a",
        'Murang\u00e2a'   : "Murang'a",
        'Taita Taveta'    : 'Taita-Taveta',
        'Trans Nzoia'     : 'Trans-Nzoia',
        'Elgeyo Marakwet' : 'Elgeyo-Marakwet',
        'Tharaka Nithi'   : 'Tharaka-Nithi',
    }
    cleaned = name_series.str.strip().replace(lookup)
    # Apply title case only to names not already in the lookup
    unlisted = ~cleaned.isin(lookup.values())
    cleaned[unlisted] = cleaned[unlisted].str.title()
    return cleaned


def load_stata(filename, **kwargs):
    """
    Load a Stata .dta file from the current working directory.
    Raises FileNotFoundError with a descriptive message if absent.
    Compatible with both script execution and Jupyter notebooks
    (avoids the use of __file__ which is undefined in notebooks).
    """
    paths = [filename, os.path.join(os.getcwd(), filename)]
    for p in paths:
        if os.path.exists(p):
            return pd.read_stata(p, **kwargs)
    raise FileNotFoundError(
        f"Could not locate '{filename}'. "
        f"Please place all KHS .dta files in the same directory as this script."
    )


