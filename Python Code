rc = cnt_pp[['county_id', 'county_name',
             'R1_approval_weeks', 'R2_rejection_rate',
             'R3_no_bylaws']].merge(fin_county, on='county_name', how='left')

# Missing indicator values filled with the national median before standardisation
rc_indicators = ['R1_approval_weeks', 'R2_rejection_rate', 'R3_no_bylaws']
for col in rc_indicators:
    n_miss = rc[col].isna().sum()
    med    = rc[col].median()
    rc[col] = rc[col].fillna(med)
    if n_miss > 0:
        print(f"  {col}: {n_miss} missing county values imputed with median ({med:.3f})")

# Standardise
Z = np.column_stack(
    [(rc[c] - rc[c].mean()) / rc[c].std() for c in rc_indicators]
)

# PCA via eigendecomposition of the correlation matrix
corr_matrix      = np.corrcoef(Z.T)
eigvals, eigvecs = np.linalg.eig(corr_matrix)
order            = np.argsort(eigvals)[::-1]
eigvals          = eigvals[order].real
eigvecs          = eigvecs[:, order].real
pct_variance     = eigvals[0] / eigvals.sum() * 100

rc['RCIndex_raw'] = Z @ eigvecs[:, 0]
rc['RCIndex']     = ((rc['RCIndex_raw'] - rc['RCIndex_raw'].min()) /
                     (rc['RCIndex_raw'].max() - rc['RCIndex_raw'].min()))

print(f"\n  PCA Correlation Matrix (R1, R2, R3):")
print(pd.DataFrame(corr_matrix, index=rc_indicators, columns=rc_indicators).round(3))
print(f"\n  Eigenvalues: {eigvals.round(3)}")
print(f"  PC1 eigenvalue  = {eigvals[0]:.3f}  "
      f"({'satisfies Kaiser criterion (>1)' if eigvals[0] > 1 else 'borderline'})")
print(f"  Variance explained by PC1: {pct_variance:.1f}%")
print(f"  PC1 loadings: R1 = {eigvecs[0,0]:.3f}   "
      f"R2 = {eigvecs[1,0]:.3f}   R3 = {eigvecs[2,0]:.3f}")
print(f"  RCIndex range: [{rc['RCIndex'].min():.3f}, {rc['RCIndex'].max():.3f}]")

