# After
cnt_pp = cnt_pp1.copy()
cnt_pp['county_id'] = cnt_pp['cg00'].astype(float).astype('Int64')
cnt_pp['county_name'] = cnt_pp['county_id'].map(county_code_map)
cnt_pp['R1_approval_weeks'] = cnt_pp['cg3']

# Indicator 2: Building rejection rate (1 - approval rate; higher = more complexity)
cnt_pp['approval_rate'] = np.where(
    cnt_pp['cg1b'] > 0,
    cnt_pp['cg4b'] / cnt_pp['cg1b'], np.nan)
cnt_pp['R2_rejection_rate'] = 1 - cnt_pp['approval_rate'].clip(0, 1)

# Indicator 3: No ratified building bylaws (1 = no bylaws = weaker legal framework)
cnt_pp['R3_no_bylaws'] = (cnt_pp['cg11'] == 0).astype(float)

# Indicator 4: Weak foreclosure mechanisms (from financiers)
fin['county_clean'] = (fin['county_name'].str.strip()
                        .str.replace('NAIROBI CITY', 'Nairobi City').str.title())
fin_agg = fin.groupby('county_clean').agg(
    R4_weak_foreclosure=('se16', lambda x: (x == 3).mean()),
    avg_interest=('se7', 'mean')
).reset_index().rename(columns={'county_clean': 'county_name'})

rc = cnt_pp[['county_id','county_name','R1_approval_weeks','R2_rejection_rate',
             'R3_no_bylaws']].merge(fin_agg, on='county_name', how='left')

# Standardize and PCA
rc_vars = ['R1_approval_weeks', 'R2_rejection_rate', 'R3_no_bylaws']
for col in rc_vars:
    rc[col] = rc[col].fillna(rc[col].median())
Z_pca = np.column_stack([(rc[c] - rc[c].mean()) / rc[c].std() for c in rc_vars])
corr_mat = np.corrcoef(Z_pca.T)
eigenvalues, eigenvectors = np.linalg.eig(corr_mat)
order = np.argsort(eigenvalues)[::-1]
eigenvalues = eigenvalues[order]; eigenvectors = eigenvectors[:, order]
var_explained = eigenvalues[0] / eigenvalues.sum() * 100
rc['RCIndex_raw'] = Z_pca @ eigenvectors[:, 0]
rc['RCIndex'] = (rc['RCIndex_raw'] - rc['RCIndex_raw'].min()) / \
                (rc['RCIndex_raw'].max() - rc['RCIndex_raw'].min())

print(f"PCA Correlation Matrix:\n{pd.DataFrame(corr_mat, index=rc_vars, columns=rc_vars).round(3)}")
print(f"\nEigenvalues: {eigenvalues.round(3)}")
print(f"PC1 variance explained: {var_explained:.1f}%")
print(f"PC1 loadings: {eigenvectors[:,0].round(3)}")
print(f"\nKMO-style check: PC1 eigenvalue={eigenvalues[0]:.3f} ({'PASS' if eigenvalues[0]>1 else 'BORDERLINE'})")
print(f"RCIndex range: [{rc['RCIndex'].min():.3f}, {rc['RCIndex'].max():.3f}]")
print(f"\nTop 5 HIGH regulatory complexity counties:")
print(rc.nlargest(5,'RCIndex')[['county_name','RCIndex','R1_approval_weeks',
                                  'R2_rejection_rate','R3_no_bylaws']].to_string(index=False))
print(f"\nTop 5 LOW regulatory complexity counties:")
print(rc.nsmallest(5,'RCIndex')[['county_name','RCIndex','R1_approval_weeks',
                                   'R2_rejection_rate','R3_no_bylaws']].to_string(index=False))


