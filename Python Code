# =============================================================================
# SECTION 5: ENDOGENOUS SWITCHING REGRESSION (ESR) MODEL
#
# The ESR framework (Lokshin & Sajaia, 2004; Dong & Hui, 2022) consists of:
#
#   Selection equation (probit):
#     Owner*_i = γ₀ + γ₁ln(rooms) + γ₂ln(area) + γ₃FamilySize
#              + γ₄ln(HP) + γ₅RCIndex + u_i
#     Owner_i = 1 if Owner*_i > 0
#
#   Outcome equations (OLS with IMR correction):
#     FRIndex₁_i = α₁₀ + α₁₁ln(rooms) + α₁₂ln(area) + α₁₃FamilySize
#                + α₁₄ln(HP) + σ₁ω₁λ₁_i + ε₁_i   [owner regime]
#
#     FRIndex₀_i = α₀₀ + α₀₁ln(rooms) + α₀₂ln(area) + α₀₃FamilySize
#                + α₀₄ln(HP) + σ₀ω₀λ₀_i + ε₀_i   [renter regime]
#
# The Inverse Mills Ratios are:
#     λ₁_i = φ(Zᵢγ) / Φ(Zᵢγ)       (for owners)
#     λ₀_i = −φ(Zᵢγ) / (1−Φ(Zᵢγ)) (for renters)
#
# ω₁ = σ_u1/(σ_u·σ₁) and ω₀ = σ_u0/(σ_u·σ₀) are the selection correlation
# parameters. A significant ω confirms selection bias and validates the ESR.
#
# The exclusion restriction: RCIndex enters the selection equation but not
# the outcome equations, as regulatory complexity affects the probability of
# homeownership through transaction costs but does not directly determine
# a household's savings behaviour conditional on tenure status.
# =============================================================================

print("\n" + "="*65)
print("STEP 4: ENDOGENOUS SWITCHING REGRESSION (ESR) ESTIMATION")
print(f"        Dependent variable: {outcome_label}")
print("="*65)

N      = len(df)
Z_vars = ['ln_rooms', 'ln_area', 'familysize', 'ln_HP', 'RCIndex']
X_vars = ['ln_rooms', 'ln_area', 'familysize', 'ln_HP']

Z_mat = np.column_stack([np.ones(N)] + [df[v].values for v in Z_vars])
X_mat = np.column_stack([np.ones(N)] + [df[v].values for v in X_vars])
y_own = df['owner'].values
y_out = df[outcome_var].values

# ---------------------------------------------------------------------------
# Step 4a: Probit selection equation
# Maximum likelihood estimation via BFGS with analytic score vector.
# ---------------------------------------------------------------------------
print("\n[4a] Probit Selection Equation...")
b0_init   = np.zeros(Z_mat.shape[1])
probit_result = minimize(
    probit_loglik, b0_init, args=(Z_mat, y_own),
    jac=probit_gradient, method='BFGS',
    options={'maxiter': 1000, 'gtol': 1e-7}
)
gamma = probit_result.x

xb_hat  = Z_mat @ gamma
Phi_hat = np.clip(normal_cdf(xb_hat), 1e-10, 1 - 1e-10)
phi_hat = normal_pdf(xb_hat)

# Information matrix standard errors
W       = phi_hat**2 / (Phi_hat * (1 - Phi_hat))
H       = (Z_mat.T * W) @ Z_mat
se_gamma = np.sqrt(np.diag(np.linalg.pinv(H)))

# Inverse Mills Ratios
lambda1 = phi_hat / Phi_hat             # IMR for owners
lambda0 = -phi_hat / (1 - Phi_hat)     # IMR for renters

# Marginal effects evaluated at the mean of the linear index
me_factor = normal_pdf(np.mean(xb_hat))
marginal_effects = {v: me_factor * gamma[i+1] for i, v in enumerate(Z_vars)}

print_regression_table(
    ['Intercept'] + Z_vars, gamma, se_gamma,
    "Table 4.3 — Probit Selection Equation (Dependent variable: Owner = 1)"
)
print(f"\n  Marginal effects at E[xβ]:")
for v, me in marginal_effects.items():
    print(f"    {v:<22}: {me:>8.4f}")

null_ll = probit_loglik(np.zeros(len(gamma)), Z_mat, y_own)
print(f"\n  Log-likelihood:        {-probit_result.fun:.2f}")
print(f"  McFadden pseudo-R²:    {1 - probit_result.fun / null_ll:.3f}")
print(f"  Observations:          {N}")

# ---------------------------------------------------------------------------
# Step 4b: Regime-specific outcome equations with IMR correction
# Each regime is estimated separately by OLS with the relevant IMR appended.
# ---------------------------------------------------------------------------
print("\n[4b] Outcome Equations (Heckman two-step with IMR correction)...")
mask_own = y_own == 1
mask_ren = y_own == 0

X1 = np.column_stack([X_mat[mask_own], lambda1[mask_own]])
X0 = np.column_stack([X_mat[mask_ren], lambda0[mask_ren]])

b1, se1, e1 = ols_with_se(X1, y_out[mask_own])
b0, se0, e0 = ols_with_se(X0, y_out[mask_ren])

sigma1 = np.std(e1);  omega1 = b1[-1] / sigma1   # ω₁ = selection corr., owners
sigma0 = np.std(e0);  omega0 = b0[-1] / sigma0   # ω₀ = selection corr., renters
r2_own = 1 - np.var(e1) / np.var(y_out[mask_own])
r2_ren = 1 - np.var(e0) / np.var(y_out[mask_ren])

print_regression_table(
    ['Intercept'] + X_vars + ['IMR (ω₁)'], b1, se1,
    f"Table 4.4 — Owner Regime (Regime 1), Dep: {outcome_var}"
)
print(f"  σ₁ = {sigma1:.4f}   ω₁ = {omega1:.4f}   R² = {r2_own:.3f}   N = {mask_own.sum()}")

print_regression_table(
    ['Intercept'] + X_vars + ['IMR (ω₀)'], b0, se0,
    f"Table 4.4 — Renter Regime (Regime 0), Dep: {outcome_var}"
)
print(f"  σ₀ = {sigma0:.4f}   ω₀ = {omega0:.4f}   R² = {r2_ren:.3f}   N = {mask_ren.sum()}")

print(f"\n  Selection bias diagnostics:")
print(f"    ω₁ = {omega1:.4f}  —  owner-regime selection-outcome correlation")
print(f"    ω₀ = {omega0:.4f}  —  renter-regime selection-outcome correlation")
if omega1 > 0 and omega0 > 0:
    print(f"    Pattern: BILATERAL POSITIVE SELECTION")
    print(f"    Households with higher unobservable financial capacity")
    print(f"    self-select into both tenure regimes (see thesis Section 5.2).")
elif omega1 < 0 and omega0 < 0:
    print(f"    Pattern: bilateral negative selection")
else:
    print(f"    Pattern: asymmetric selection")
esr_justified = abs(omega1) > 0.1 or abs(omega0) > 0.1
print(f"    ESR correction {'warranted' if esr_justified else 'marginal'}: "
      f"at least one ω significantly different from zero.")


# =============================================================================
# SECTION 6: COUNTERFACTUAL ANALYSIS AND AVERAGE TREATMENT EFFECT ON THE TREATED
#
# The ATT is defined as:
#   ATT = E[FRIndex₁ | Owner=1] − E[FRIndex₀ | Owner=1]
#       = (actual FRIndex for owners) − (counterfactual FRIndex had they rented)
#
# The counterfactual is evaluated using the renter-regime coefficients (b0)
# applied to the owner sample's characteristics and IMRs.
# Bootstrap standard errors (500 replications) account for the two-step
# estimation uncertainty in the IMR correction.
# =============================================================================

print("\n" + "="*65)
print("STEP 5: COUNTERFACTUAL ANALYSIS AND ATT ESTIMATION")
print("="*65)

E_Y1_actual = np.mean(y_out[mask_own])
E_Y0_counter = np.mean(X_mat[mask_own] @ b0[:-1] + b0[-1] * lambda0[mask_own])
E_Y0_actual  = np.mean(y_out[mask_ren])
E_Y1_counter = np.mean(X_mat[mask_ren] @ b1[:-1] + b1[-1] * lambda1[mask_ren])

ATT = E_Y1_actual  - E_Y0_counter   # owners vs. their counterfactual as renters
ATU = E_Y1_counter - E_Y0_actual    # renters vs. their counterfactual as owners

# Bootstrap (500 replications, seed fixed for reproducibility)
np.random.seed(42)
att_bootstrap = []
for _ in range(500):
    idx  = np.random.choice(N, N, replace=True)
    ds   = df.iloc[idx].reset_index(drop=True)
    Zb   = np.column_stack([np.ones(len(ds))] + [ds[v].values for v in Z_vars])
    Xb   = np.column_stack([np.ones(len(ds))] + [ds[v].values for v in X_vars])
    yob  = ds['owner'].values
    yhb  = ds[outcome_var].values
    try:
        res  = minimize(probit_loglik, np.zeros(Zb.shape[1]),
                        args=(Zb, yob), method='BFGS',
                        options={'maxiter': 200})
        gb   = res.x
        xbb  = np.clip(Zb @ gb, -10, 10)
        l0b  = -normal_pdf(xbb) / np.clip(1 - normal_cdf(xbb), 1e-10, 1)
        m1b  = yob == 1;  m0b = yob == 0
        b0b, _, _ = ols_with_se(np.column_stack([Xb[m0b], l0b[m0b]]), yhb[m0b])
        att_b = (np.mean(yhb[m1b]) -
                 np.mean(Xb[m1b] @ b0b[:-1] + b0b[-1] * l0b[m1b]))
        att_bootstrap.append(att_b)
    except Exception:
        pass

att_se = np.std(att_bootstrap)
att_z  = ATT / att_se
att_p  = 2 * (1 - stats.norm.cdf(abs(att_z)))

print(f"\n  Table 4.5 — Counterfactual Analysis:")
print(f"  {'Group':<28} {'Actual':>10} {'Counterfactual':>15} {'ATT/ATU':>10}")
print("  " + "-"*65)
sig_str = ('***' if att_p < 0.001 else '**' if att_p < 0.01
           else '*' if att_p < 0.05 else '')
print(f"  {'Owners (ATT)':<28} {E_Y1_actual:>10.4f} {E_Y0_counter:>15.4f} "
      f"{ATT:>+10.4f}{sig_str}")
print(f"  {'Renters (ATU)':<28} {E_Y0_actual:>10.4f} {E_Y1_counter:>15.4f} "
      f"{ATU:>+10.4f}")
print(f"\n  Bootstrap SE (500 replications): {att_se:.4f}")
print(f"  z-statistic: {att_z:.3f}   p-value: {att_p:.4f}")

print(f"\n  Interpretation:")
if ATT > 0:
    print(f"  ATT = +{ATT:.4f}: Homeownership causally increases financial resilience")
    print(f"  by {ATT:.4f} FRIndex units relative to the counterfactual renting scenario.")
    print(f"  The positive ATT is consistent with the savings discipline mechanism:")
    print(f"  ownership obligations strengthen household financial management behaviour")
    print(f"  (formal savings, emergency buffer, chama participation) even as they")
    print(f"  constrain non-housing consumption (cf. Dong & Hui, 2022, Section 5.1).")
    print(f"  H1 (negative ATT) is not supported by the Kenyan evidence.")
else:
    print(f"  ATT = {ATT:.4f}: Homeownership causally reduces financial resilience.")
    print(f"  Consistent with the background risk hypothesis (Grossman & Laroque, 1990).")
    print(f"  H1 is supported.")


