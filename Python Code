def _generate_county_pp_data():
    """
    Synthetic county physical planning data.
    The four study counties (Mombasa=1, Nakuru=32, Kisumu=42, Nairobi=47)
    are set to the exact values reported in thesis Table 4.2.
    Remaining counties are drawn from plausible distributions.
    """
    np.random.seed(0)
    # Study county values from Table 4.2
    fixed = {1: (30, 0.213, 0), 32: (50, 0.093, 1),
             42: (30, 0.135, 0), 47: (14, 0.000, 0)}
    records = []
    for cg00 in range(1, 48):
        if cg00 in fixed:
            r1, rej, bylaws = fixed[cg00]
            cg1b = 500
            cg4b = round(cg1b * (1 - rej))
        else:
            r1      = int(np.random.choice([7, 14, 21, 30, 50]))
            cg1b    = int(np.random.randint(10, 700))
            rej     = np.random.uniform(0, 0.4)
            cg4b    = int(cg1b * (1 - rej))
            bylaws  = int(np.random.choice([0, 1]))
        records.append({'cg00': str(cg00), 'cg1b': float(cg1b),
                        'cg4b': float(cg4b), 'cg3': float(r1),
                        'cg11': float(bylaws)})
    return pd.DataFrame(records)


