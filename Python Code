# =====================================================================
print("\n" + "="*65)
print("STEP 3: BUILDING ANALYSIS DATASET")
print("="*65)

urban = dwelling[dwelling['a07_1'] == 'Urban'].copy()
urban_or = urban[urban['d12'].isin(['OWNS', 'PAYS RENT/LEASE'])].copy()
urban_or['owner'] = (urban_or['d12'] == 'OWNS').astype(int)
urban_or['county_id'] = urban_or['a01'].map(county_name_to_id)
urban_or = urban_or.merge(rc[['county_id', 'RCIndex', 'avg_interest']], on='county_id', how='left')

# Housing Quality Index (HQIndex) - financial resilience proxy
floor_map = {'Earth/sand':0,'Dung':0,'Mud/cow dung':0,'Palm/ bamboo':1,
             'Wood planks/shingles/timber':1,'Vinyl or asphalt strips':2,
             'Concrete/ Cement/Terrazo':2,'Ceramic tiles':3,
             'Parquet or polished wood':3,'Wall to wall Carpet':3}
wall_map = {'No walls':0,'Cane/palm/trunks':0,'Grass/reeds':0,'Mud/cow dung':0,
            'Bamboo with mud':0,'Stone with mud':1,'Uncovered adobe':1,
            'Plywood/Cardboard':1,'Reused wood':1,'Iron sheets':1,'Covered adobe':1,
            'Bricks':2,'Cement blocks':2,'Concrete/Cement':2,
            'Stone with lime/cement':3,'Wood planks/shingles/timber':1,'Precast wall':3}

urban_or['floor_s']  = urban_or['d14'].map(floor_map).fillna(1)
urban_or['wall_s']   = urban_or['d15'].map(wall_map).fillna(1)
urban_or['elec']     = (urban_or['d05'] == 'Yes').astype(float)
urban_or['water']    = (urban_or['d06'] == 'Yes').astype(float)

for c in ['floor_s', 'wall_s', 'elec', 'water']:
    mu, sd = urban_or[c].mean(), urban_or[c].std()
    urban_or[c + '_z'] = (urban_or[c] - mu) / (sd if sd > 0 else 1)
urban_or['HQIndex'] = urban_or[['floor_s_z','wall_s_z','elec_z','water_z']].mean(axis=1)

# Regressors
urban_or['ln_rooms']    = np.log1p(urban_or['d08'].fillna(urban_or['d08'].median()))
urban_or['ln_area']     = np.log1p(urban_or['d11_1'].clip(1, 5000).fillna(100))
urban_or['familysize']  = urban_or['d13'].fillna(urban_or['d13'].median())
urban_or['ln_HP']       = np.log1p(urban_or['avg_interest'].fillna(urban_or['avg_interest'].median()))
urban_or['RC_high']     = (urban_or['RCIndex'] > urban_or['RCIndex'].median()).astype(int)
urban_or['formal_housing'] = urban_or['d03'].isin(['FLAT / APARTMENT','MAISONETTE','TOWNHOUSE']).astype(int)

df = urban_or[['owner','HQIndex','ln_rooms','ln_area','familysize','ln_HP',
               'RCIndex','RC_high','county_id','elec','water','floor_s',
               'wall_s','formal_housing']].dropna().reset_index(drop=True)

print(f"Final sample: N = {len(df)}")
print(f"Owners: {df['owner'].sum()} ({df['owner'].mean()*100:.1f}%)")
print(f"Renters: {(1-df['owner']).sum()} ({(1-df['owner']).mean()*100:.1f}%)")

# Descriptive statistics (Table 1 equivalent)
print("\nTABLE 1: DESCRIPTIVE STATISTICS")
desc_vars = ['HQIndex','ln_rooms','ln_area','familysize','ln_HP','RCIndex',
             'owner','elec','water']
