print("\n" + "="*65)
print("STEP 2: CONSTRUCTING RCIndex (PCA)")
print("="*65)

county_code_map = {
    1:'Mombasa',2:'Kwale',3:'Kilifi',4:'Tana River',5:'Lamu',6:'Taita-Taveta',
    7:'Garissa',8:'Wajir',9:'Mandera',10:'Marsabit',11:'Isiolo',12:'Meru',
