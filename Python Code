# =====================================================================
# 0. HELPER FUNCTIONS
# =====================================================================
def normal_pdf(x):
    return np.exp(-0.5 * x**2) / np.sqrt(2 * np.pi)

def normal_cdf(x):
    return ndtr(x)

def probit_loglik(beta, X, y):
    """Probit log-likelihood."""
    xb = np.clip(X @ beta, -10, 10)
    p = np.clip(normal_cdf(xb), 1e-10, 1 - 1e-10)
    return -np.sum(y * np.log(p) + (1 - y) * np.log(1 - p))

def probit_gradient(beta, X, y):
    """Analytic gradient of probit log-likelihood."""
    xb = np.clip(X @ beta, -10, 10)
    p = np.clip(normal_cdf(xb), 1e-10, 1 - 1e-10)
    phi = normal_pdf(xb)
    resid = (y - p) * phi / (p * (1 - p))
    return -(X.T @ resid)

def ols_with_se(X, y):
    """OLS with classical standard errors."""
    b, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    e = y - X @ b
    s2 = np.sum(e**2) / (len(y) - X.shape[1])
    cov = s2 * np.linalg.pinv(X.T @ X)
    se = np.sqrt(np.diag(cov))
    return b, se, e

def print_table(varnames, coefs, ses, title, df_resid):
    """Pretty-print regression table."""
    print(f"\n{'='*65}")
    print(title)
    print(f"{'='*65}")
    print(f"{'Variable':<22} {'Coef':>8} {'SE':>8} {'t/z':>8} {'p':>7}  Sig")
    print("-" * 65)
    ts = coefs / ses
    ps = 2 * (1 - stats.norm.cdf(np.abs(ts)))
    for n, c, s, t, p in zip(varnames, coefs, ses, ts, ps):
        sig = ('***' if p < 0.001 else '**' if p < 0.01
               else '*' if p < 0.05 else '.' if p < 0.1 else '')
        print(f"{n:<22} {c:>8.4f} {s:>8.4f} {t:>8.3f} {p:>7.4f}  {sig}")
    print("-" * 65)


